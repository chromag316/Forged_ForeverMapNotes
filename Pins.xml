<Ui xmlns="http://www.blizzard.com/wow/ui/">
    <Frame name="ForgedForeverMapNotesPinTemplate" mixin="ForgedForeverMapNotesPinMixin" enableMouse="true" virtual="true">
        <Size x="16" y="16"/>
        <Layers>
            <Layer level="ARTWORK">
                <Texture parentKey="Icon" setAllPoints="true"/>
            </Layer>
        </Layers>
        <!-- No OnEnter/OnLeave/OnMouseUp here: the map canvas installs its
             own and calls the mixin's OnMouseEnter/OnMouseLeave/OnMouseUp.
             It asserts these are unset when it creates a pin, and that
             error broke the first pin drawn after a reload. -->
        <Scripts>
            <OnLoad method="OnLoad"/>
        </Scripts>
    </Frame>
</Ui>
